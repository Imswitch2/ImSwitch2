+        y=np.empty(count*3,dtype=np.float64)
+        x[0::3]=source[0]; x[1::3]=target[0]; x[2::3]=np.nan
+        y[0::3]=source[1]; y[1::3]=target[1]; y[2::3]=np.nan
+        return x,y
