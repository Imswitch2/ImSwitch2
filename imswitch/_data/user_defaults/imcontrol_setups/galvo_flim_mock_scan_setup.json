        "fit_method": "moment",
        "laser_rep_rate_mhz": 80.0,
        "background_rate_hz": 0.0,
        "displayRotation": "0",
        "displayFlipX": "False",
        "displayFlipY": "False"
      },
      "analogChannel": null,
      "digitalLine": null,
      "forAcquisition": true,
      "forFocusLock": false
    }
  },
