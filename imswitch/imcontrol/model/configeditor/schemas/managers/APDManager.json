{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "cameraPixelSizeUm": {
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)"
      ]
    },
    "ctrInputLine": {
      "description": "Counter that the physical terminal is connected to.  If an int ``N`` is given it is expanded to ``\"<deviceName>/ctr<N>\"``; otherwise the string is used verbatim.",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "code:required",
        "example:string"
      ]
    },
    "deviceName": {
      "description": "NI-DAQ device prefix used when ``ctrInputLine`` is given as an int.",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "code:default:string",
        "code:optional(get)"
      ]
    },
    "liveUpdateIntervalMs": {
      "description": "Minimum wall-clock gap between live-preview redraws during a scan (50 ms = 20 Hz).  The image is filled in line by line, but pushing every line to the viewer floods the GUI on fast scans; this bounds the redraw rate independently of line rate and image size.  Raise it if the GUI still lags on a very fast rig, lower it for a more fluid preview on slow scans.  Does not affect acquired or recorded data.",
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-kind": "number",
      "x-imswitch-source": [
        "code:default:number",
        "code:float()",
        "code:optional(get)"
      ]
    },
    "mockPhotonCountMax": {
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-aliases": [
        "mock_photon_count_max"
      ],
      "x-imswitch-kind": "integer",
      "x-imswitch-source": [
        "code:default:integer",
        "code:int()",
        "code:optional(get)"
      ]
    },
    "mockPhotonCountMean": {
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-aliases": [
        "mock_photon_count_mean"
      ],
      "x-imswitch-kind": "number",
      "x-imswitch-source": [
        "code:default:number",
        "code:float()",
        "code:optional(get)"
      ]
    },
    "mockRandomSeed": {
      "x-imswitch-aliases": [
        "mock_random_seed"
      ],
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)"
      ]
    },
    "mock_photon_count_max": {
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-alias-of": "mockPhotonCountMax",
      "x-imswitch-kind": "integer",
      "x-imswitch-source": [
        "code:default:integer",
        "code:int()",
        "code:optional(get)"
      ]
    },
    "mock_photon_count_mean": {
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-alias-of": "mockPhotonCountMean",
      "x-imswitch-kind": "number",
      "x-imswitch-source": [
        "code:default:number",
        "code:float()",
        "code:optional(get)"
      ]
    },
    "mock_random_seed": {
      "x-imswitch-alias-of": "mockRandomSeed",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)"
      ]
    },
    "simulation_mode": {
      "x-imswitch-kind": "boolean",
      "x-imswitch-source": [
        "code:default:boolean",
        "code:optional(get)"
      ]
    },
    "terminal": {
      "description": "Physical input terminal on the NI DAQ that the APD pulse train is wired to (e.g. ``\"PFI0\"``).",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "code:required",
        "example:string"
      ]
    }
  },
  "required": [
    "ctrInputLine",
    "terminal"
  ],
  "title": "APDManager managerProperties",
  "type": "object",
  "x-imswitch-classes": [
    "APDManager",
    "DetectorManager"
  ]
}
