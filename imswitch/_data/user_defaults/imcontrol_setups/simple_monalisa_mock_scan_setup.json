    "Camera": {
      "analogChannel": null,
      "digitalLine": "Dev1/port0/line4",
      "managerName": "AVManager",
      "managerProperties": {
        "cameraListIndex": "mock",
        "cameraPixelSizeUm": 0.1,
        "avcam": {
          "exposure": 1,
          "gain": 1
        }
      },
      "forAcquisition": true,
      "forFocusLock": false
    }
  },
