      "valueRangeMin": 0,
      "valueRangeMax": 200
    },
    "405 (ON)": {
      "analogChannel": null,
      "digitalLine": "Dev1/port0/line2",
      "managerName": "NidaqLaserManager",
      "managerProperties": {},
      "wavelength": 405,
      "valueRangeMin": 0,
      "valueRangeMax": 200
    },
    "488 (EXC)": {
