{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "The top-level keys of a slm entry in a setup file, as imswitch.imcontrol.model.SetupInfo.SLMsInfo declares them. managerProperties is described per manager under managers/. Keys the dataclass does not declare are kept but not read.",
  "properties": {
    "analogChannel": {
      "default": null,
      "description": "Channel for analog communication. ``null`` if the device is digital or doesn't use NI-DAQ. If an integer is specified, it will be translated to \"Dev1/ao{analogChannel}\".",
      "type": [
        "string",
        "integer",
        "null"
      ],
      "x-imswitch-kind": [
        "string",
        "integer"
      ],
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:DeviceInfo.analogChannel: Optional[Union[str, int]]"
      ]
    },
    "connectOnStartup": {
      "default": false,
      "description": "For a transient device: still try to connect at startup; a failure leaves it absent with the error shown, never in mock.",
      "type": "boolean",
      "x-imswitch-kind": "boolean",
      "x-imswitch-source": [
        "dataclass:DeviceInfo.connectOnStartup: bool"
      ]
    },
    "correctionPatternsDir": {
      "default": null,
      "description": "Legacy multiple-SLM correction directory.",
      "type": [
        "string",
        "null"
      ],
      "x-imswitch-kind": "string",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.correctionPatternsDir: Optional[str]"
      ]
    },
    "definition": {
      "default": {},
      "description": "Canonical physical SLM definition owned by slmcore.",
      "type": "object",
      "x-imswitch-kind": "object",
      "x-imswitch-source": [
        "dataclass:SLMsInfo.definition: Dict[str, Any]"
      ]
    },
    "digitalLine": {
      "default": null,
      "description": "Line for digital communication. ``null`` if the device is analog or doesn't use NI-DAQ. If an integer is specified, it will be translated to \"Dev1/port0/line{digitalLine}\".",
      "type": [
        "string",
        "integer",
        "null"
      ],
      "x-imswitch-kind": [
        "string",
        "integer"
      ],
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:DeviceInfo.digitalLine: Optional[Union[str, int]]"
      ]
    },
    "height": {
      "default": null,
      "description": "Legacy JSON field ``height`` kept only for compatibility.",
      "type": [
        "integer",
        "null"
      ],
      "x-imswitch-kind": "integer",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.legacyHeight: Optional[int]"
      ]
    },
    "managerName": {
      "description": "Manager class name.",
      "type": "string",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "dataclass:DeviceInfo.managerName: str"
      ]
    },
    "managerProperties": {
      "default": {},
      "description": "Properties to be read by the manager. Empty when omitted.",
      "type": "object",
      "x-imswitch-kind": "object",
      "x-imswitch-source": [
        "dataclass:DeviceInfo.managerProperties: Dict[str, Any]"
      ]
    },
    "monitorIdx": {
      "default": null,
      "description": "Legacy ImSwitch display-manager monitor index.",
      "type": [
        "integer",
        "null"
      ],
      "x-imswitch-kind": "integer",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.monitorIdx: Optional[int]"
      ]
    },
    "nSections": {
      "default": null,
      "description": "Legacy JSON field ``nSections`` kept for compatibility.",
      "type": [
        "integer",
        "null"
      ],
      "x-imswitch-kind": "integer",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.legacyNSections: Optional[int]"
      ]
    },
    "pixelSize": {
      "default": null,
      "description": "Legacy JSON field ``pixelSize`` kept only for compatibility.",
      "type": [
        "number",
        "null"
      ],
      "x-imswitch-kind": "number",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.legacyPixelSize: Optional[float]"
      ]
    },
    "serial_number": {
      "default": null,
      "description": "Legacy JSON field ``serial_number`` kept only for compatibility.",
      "type": [
        "string",
        "null"
      ],
      "x-imswitch-kind": "string",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.legacySerialNumber: Optional[str]"
      ]
    },
    "startup_preferences": {
      "default": {},
      "description": "Persistent startup/session preferences owned by slmcore.",
      "type": "object",
      "x-imswitch-kind": "object",
      "x-imswitch-source": [
        "dataclass:SLMsInfo.startup_preferences: Dict[str, Any]"
      ]
    },
    "transient": {
      "default": false,
      "description": "Declared but not required at startup: left absent (not an error, no mock) until connected from the Hardware status window or a script. For devices that are plugged in only when needed.",
      "type": "boolean",
      "x-imswitch-kind": "boolean",
      "x-imswitch-source": [
        "dataclass:DeviceInfo.transient: bool"
      ]
    },
    "wavelengthTableFile": {
      "default": null,
      "description": "Legacy multiple-SLM wavelength table file.",
      "type": [
        "string",
        "null"
      ],
      "x-imswitch-kind": "string",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.wavelengthTableFile: Optional[str]"
      ]
    },
    "widgetOptions": {
      "default": null,
      "description": "Legacy multiple-SLM widget options.",
      "type": [
        "object",
        "null"
      ],
      "x-imswitch-kind": "object",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.widgetOptions: Optional[Dict[str, Any]]"
      ]
    },
    "width": {
      "default": null,
      "description": "Legacy JSON field ``width`` kept only for compatibility.",
      "type": [
        "integer",
        "null"
      ],
      "x-imswitch-kind": "integer",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "dataclass:SLMsInfo.legacyWidth: Optional[int]"
      ]
    }
  },
  "required": [
    "managerName"
  ],
  "title": "slm device entry (SLMsInfo)",
  "type": "object",
  "x-imswitch-classes": [
    "SLMsInfo",
    "DeviceInfo"
  ],
  "x-imswitch-info-class": "SLMsInfo"
}
