        "vel_max": 0.1,
        "acc_max": 0.0001
      },
      "axes": [
        "Y"
      ],
      "forScanning": true,
      "forPositioning": true
    },
    "Z": {
      "analogChannel": "Dev1/ao2",
      "digitalLine": null,
      "managerName": "NidaqPositionerManager",
      "managerProperties": {
        "conversionFactor": 1.0,
        "minVolt": 0,
        "maxVolt": 10,
        "vel_max": 1000.0,
        "acc_max": 1000.0,
        "smoothScan": false
      },
      "axes": [
        "Z"
      ],
      "forScanning": true,
      "forPositioning": true
    }
  },
  "scan": {
