{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "analogInputLine": {
      "description": "NI-DAQ analog input line the PMT is wired to.  If an int ``N`` is given it is expanded to ``\"<deviceName>/ai<N>\"``; otherwise the string is used verbatim.",
      "x-imswitch-kind": [
        "integer",
        "string"
      ],
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)",
        "docs:integer",
        "docs:string"
      ]
    },
    "cameraPixelSizeUm": {
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)"
      ]
    },
    "deviceName": {
      "description": "NI-DAQ device prefix used when ``analogInputLine`` is given as an int.",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "code:default:string",
        "code:optional(get)"
      ]
    },
    "liveUpdateIntervalMs": {
      "description": "Minimum wall-clock gap between live-preview redraws during a scan (50 ms = 20 Hz).  Same meaning as for ``APDManager``; bounds GUI redraws only, never acquired data.",
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-kind": "number",
      "x-imswitch-source": [
        "code:default:number",
        "code:float()",
        "code:optional(get)"
      ]
    },
    "mockRandomSeed": {
