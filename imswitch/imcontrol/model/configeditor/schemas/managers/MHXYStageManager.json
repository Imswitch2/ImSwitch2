{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "acceleration": {
      "description": "Optional. Acceleration in m/s² (Tango ``!accel``), one number for both",
      "x-imswitch-kind": [
        "number",
        "object"
      ],
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)",
        "docs:number",
        "docs:object"
      ]
    },
    "rs232device": {
      "description": "Name of the RS-232 channel registered in ``rs232sManager``.",
      "x-imswitch-kind": "string",
      "x-imswitch-nullable": true,
      "x-imswitch-ref-category": "rs232devices",
      "x-imswitch-source": [
        "code:optional(get)",
        "example:string"
      ],
      "x-imswitch-widget": "ref"
    },
    "useMockOnFailure": {
      "description": "Optional, default ``false``. When the ``rs232device`` cannot be looked",
      "x-imswitch-kind": "boolean",
      "x-imswitch-source": [
        "code:default:boolean",
        "code:optional(get)"
      ]
    },
    "velocity": {
      "description": "Optional. Travel speed in revolutions of the spindle per second",
      "x-imswitch-kind": [
        "number",
        "object"
      ],
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)",
        "docs:number",
        "docs:object"
      ]
    }
  },
  "title": "MHXYStageManager managerProperties",
  "type": "object",
  "x-imswitch-classes": [
    "MHXYStageManager",
    "PositionerManager"
  ]
}
