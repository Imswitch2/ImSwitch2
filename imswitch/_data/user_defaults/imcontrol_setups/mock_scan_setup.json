{
    "__comment__": "Hardware-free MoNaLISA advanced-scan setup for testing the live-reconstruction pipeline. Uses ONLY a mock AVManager camera and MockPositionerManager stages with a simulated NIDAQ (no physical analog/digital channels, no nidaqmx required), so it boots with no hardware. Select the 'MoNaLISA' (advanced) scan, set the scan geometry, then run a Scan-once / Scan-lapse recording: it writes .zarr/.hdf5 with ScanStage metadata that the live reconstruction (ImProcess) reads. The recorded frames are mock content, so reconstructions are structurally valid but not meaningful images - the goal is to exercise the record -> watch-folder -> live-reconstruction loop end to end. See docs/improcess.rst and docs/design/plans/live-reconstruction-port.md.",
    "detectors": {
        "Camera": {
            "analogChannel": null,
            "digitalLine": null,
            "managerName": "AVManager",
            "managerProperties": {
                "cameraListIndex": "mock",
                "avcam": {
                    "exposure": 100,
                    "gain": 1
                }
            },
            "forAcquisition": true
        }
    },
    "lasers": {},
    "positioners": {
        "X": {
            "analogChannel": null,
            "digitalLine": null,
            "managerName": "MockPositionerManager",
            "managerProperties": {},
            "axes": ["X"],
            "forScanning": true,
            "forPositioning": true,
            "resetOnClose": false
        },
        "Y": {
            "analogChannel": null,
            "digitalLine": null,
            "managerName": "MockPositionerManager",
            "managerProperties": {},
            "axes": ["Y"],
            "forScanning": true,
            "forPositioning": true,
            "resetOnClose": false
        },
        "Z": {
            "analogChannel": null,
            "digitalLine": null,
            "managerName": "MockPositionerManager",
            "managerProperties": {},
            "axes": ["Z"],
            "forScanning": true,
            "forPositioning": true,
            "resetOnClose": false
        }
    },
    "scan": {
        "scanWidgetType": "MoNaLISA",
        "scanDesigner": "BetaScanDesigner",
        "scanDesignerParams": {
            "return_time": 0.01
        },
        "TTLCycleDesigner": "BetaTTLCycleDesigner",
        "TTLCycleDesignerParams": {},
        "sampleRate": 100000,
        "lineClockLine": null,
        "frameStartClockLine": null,
        "frameEndClockLine": null
    },
    "nidaq": {
        "timerCounterChannel": null,
        "startTrigger": false,
        "simulation": true
    },
    "availableWidgets": [
        "Settings",
        "View",
        "Recording",
        "Image",
        "Positioner",
        "Scan",
        "BeadRec",
        "FFT"
    ]
}
