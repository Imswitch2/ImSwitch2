        "code:required",
        "example:string"
      ]
    },
    "cameraPixelSizeUm": {
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)"
      ]
    }
  },
  "required": [
    "avcam",
    "cameraListIndex"
  ],
  "title": "AVManager managerProperties",
  "type": "object",
  "x-imswitch-classes": [
    "AVManager",
    "DetectorManager"
  ]
