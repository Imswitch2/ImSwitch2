{
  "name": "scan the cells (mock APD demo)",
  "schema": 1,
  "description": "The shipped demo for galvo_apd_simple_mock_scan_setup.json: an overview scan of the synthetic sample (60 um, the 488 laser) on arm; the frame is smoothed (Gaussian, 3 px) and thresholded (Otsu), the overview is shown for three seconds (a wait action), and every cell found is scanned finely, one after the other (12 um at 50 nm, the 561 laser), centred on its centroid; then an overview again, and so on. With no cell found, the overview repeats. Run it in Experiment after creating the two setup modes the roles name (Validate only logs the first overview).",
  "metadata": {
    "smart_pipeline": {
      "roles": {
        "scouting": "pipeline-scouting",
        "idle": "pipeline-idle"
      }
    }
  },
  "steps": [
    {
      "step": "live",
      "id": "apd",
      "detector": "APD"
    },
    {
      "step": "process",
      "id": "smooth",
      "processor": "filter",
      "params": {
        "method": "gaussian",
        "radius": 3.0
      },
      "inputs": [
        "apd"
      ]
    },
    {
      "step": "process",
      "id": "thr",
      "processor": "threshold",
      "params": {
        "method": "otsu",
        "min_area": 40
      },
      "inputs": [
        "smooth"
      ]
    },
    {
      "step": "process",
      "id": "rp",
      "processor": "regionprops",
      "params": {
        "frame": "detector:APD"
      },
      "inputs": [
        "thr",
        "smooth"
      ]
    },
    {
      "step": "gate",
      "id": "found",
      "rule": "condition",
      "inputs": [
        "rp"
      ]
    },
    {
      "step": "gate",
      "id": "nothing",
      "rule": "condition",
      "inputs": [
        "rp"
      ],
      "params": {
        "invert": true
      }
    },
    {
      "step": "transform",
      "id": "tf",
      "transform": "apd_scan_geometry",
      "inputs": [
        "found"
      ]
    },
    {
      "step": "action",
      "id": "look",
      "action": "wait",
      "params": {
        "seconds": 3.0
      },
      "inputs": [
        "found"
      ]
    },
    {
      "step": "action",
      "id": "fine",
      "action": "run-scan",
      "params": {
        "mode": "acquisition",
        "length_um": 12.0,
        "pixel_um": 0.05,
        "lasers": [
          "561 (EXC)"
        ],
        "frame": "scanner:galvo",
        "points": "all"
      },
      "inputs": [
        "tf",
        "look.done"
      ]
    },
    {
      "step": "action",
      "id": "back",
      "action": "run-scan",
      "params": {
        "mode": "overview",
        "field_um": 60.0,
        "lasers": [
          "488 (EXC)"
        ]
      },
      "inputs": [
        "fine.done"
      ]
    },
    {
      "step": "action",
      "id": "again",
      "action": "run-scan",
      "params": {
        "mode": "overview",
        "field_um": 60.0,
        "lasers": [
          "488 (EXC)"
        ]
      },
      "inputs": [
        "nothing"
      ],
      "on_arm": true
    },
    {
      "step": "sink",
      "id": "log",
      "sink": "event-log",
      "inputs": [
        "rp"
      ]
    },
    {
      "step": "sink",
      "id": "marks",
      "sink": "overlay",
      "inputs": [
        "rp"
      ]
    }
  ]
}
