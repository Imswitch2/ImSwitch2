{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "conversionFactor": {
      "description": "µm per volt. The engine converts a scan's positions with it too.",
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-kind": "number",
      "x-imswitch-source": [
        "code:float()",
        "code:required"
      ]
    },
    "maxVolt": {
      "description": "The highest voltage a move may command (optional).",
      "x-imswitch-kind": "number",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)",
        "example:number"
      ]
    },
    "minVolt": {
      "description": "The lowest voltage a move may command (optional): a move below it",
      "x-imswitch-kind": "number",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)",
        "example:number"
      ]
    }
  },
  "required": [
    "conversionFactor"
  ],
  "title": "StepBoardPositionerManager managerProperties",
  "type": "object",
  "x-imswitch-classes": [
    "StepBoardPositionerManager",
    "PositionerManager"
  ]
}
