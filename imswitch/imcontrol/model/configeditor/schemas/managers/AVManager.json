{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "avcam": {
      "description": "Dictionary of AV camera property name → value pairs applied via ``setPropertyValue`` at startup.",
      "type": "object",
      "x-imswitch-kind": "object",
