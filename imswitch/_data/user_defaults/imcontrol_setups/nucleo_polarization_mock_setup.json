{
    "__comment__": "Hardware-free setup of the polarization rig (formerly run by Microscope_GUI): a Nucleo-H7A3ZI-Q as a step board speaking IMSWITCH_STEP/1 (docs/devices/step-engine-protocol.rst), simulated here. The Nucleo drives galvo X and Y on dac0/dac1 (0-3.3 V, 12 bits) and three TTL lines: the 405 and 488 Cobolts' modulation inputs (ttl0, ttl1) and the Hamamatsu's trigger (ttl2). The Expert panel runs on it (scan.engine); the rig's modes are scan programs built by imswitch/imcontrol/model/scan_program/legacy_microscope_gui.py. The two Elliptec mounts (one waveplate each) are rotators: a scan program cannot drive a serial device, so the polarization loop is a script. To use the real board, replace port \"simulated\" and simulatedBoard with the serial port, baudrate and replyTimeoutS. Placeholders until the rig's values are known: the galvos' conversionFactor (um per volt), the lasers' ports, the Elliptec port, and the piezo, which stands in as a mock positioner until the BPC303 manager exists.",
    "detectors": {
        "Hamamatsu": {
            "analogChannel": null,
            "digitalLine": "nucleo/ttl2",
            "managerName": "HamamatsuManager",
            "managerProperties": {
                "cameraListIndex": "mock",
                "hamamatsu": {
                    "trigger_source": 2,
                    "subarray_hpos": 0,
                    "subarray_vpos": 0,
                    "subarray_hsize": 512,
                    "subarray_vsize": 512,
                    "image_width": 512,
                    "image_height": 512
                }
            },
            "forAcquisition": true,
            "forFocusLock": false
        }
    },
    "lasers": {
        "405": {
            "analogChannel": null,
            "digitalLine": "nucleo/ttl0",
            "managerName": "Cobolt0601NewLaserManager",
            "managerProperties": {
                "simulation": true,
                "digitalPorts": ["COM4"]
            },
            "wavelength": 405,
            "valueRangeMin": 0.0,
            "valueRangeMax": 250.0,
            "valueRangeStep": 0.1
        },
        "488": {
            "analogChannel": null,
            "digitalLine": "nucleo/ttl1",
            "managerName": "Cobolt0601NewLaserManager",
            "managerProperties": {
                "simulation": true,
                "digitalPorts": ["COM5"]
            },
            "wavelength": 488,
            "valueRangeMin": 0.0,
            "valueRangeMax": 200.0,
            "valueRangeStep": 0.1
        }
    },
