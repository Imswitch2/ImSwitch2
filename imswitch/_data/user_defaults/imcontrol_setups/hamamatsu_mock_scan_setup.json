{
    "__comment__": "Hardware-free Hamamatsu scan setup. Uses a MockHamamatsu camera in external frame-trigger mode plus MockPositionerManager stages and simulated NI-DAQ timing. No physical AO/DO channels or nidaqmx hardware are required: analogChannel values are null, and the camera's digitalLine is a simulated line that only lets the Scan widget gate it (a scan recording needs a camera TTL per position to know how many frames to expect). The scan simulator generates virtual frame triggers for the mock camera.",
    "detectors": {
        "Camera": {
            "analogChannel": null,
            "digitalLine": "Dev1/port0/line0",
            "managerName": "HamamatsuManager",
            "managerProperties": {
                "cameraListIndex": "mock",
                "hamamatsu": {
                    "exposure_time": 0.01,
                    "trigger_source": 2,
                    "subarray_hpos": 0,
                    "subarray_vpos": 0,
                    "subarray_hsize": 512,
                    "subarray_vsize": 512,
                    "image_width": 512,
                    "image_height": 512
                }
            },
            "forAcquisition": true,
            "forFocusLock": false
        }
    },
    "lasers": {},
    "positioners": {
        "X": {
            "analogChannel": null,
            "digitalLine": null,
            "managerName": "MockPositionerManager",
            "managerProperties": {},
            "axes": ["X"],
            "forScanning": true,
            "forPositioning": true,
            "resetOnClose": false
        },
        "Y": {
            "analogChannel": null,
            "digitalLine": null,
            "managerName": "MockPositionerManager",
            "managerProperties": {},
            "axes": ["Y"],
            "forScanning": true,
            "forPositioning": true,
            "resetOnClose": false
        },
        "Z": {
            "analogChannel": null,
            "digitalLine": null,
            "managerName": "MockPositionerManager",
            "managerProperties": {},
            "axes": ["Z"],
            "forScanning": true,
            "forPositioning": true,
            "resetOnClose": false
        }
    },
    "scan": {
        "scanWidgetType": "Base",
        "scanDesigner": "BetaScanDesigner",
        "scanDesignerParams": {
            "return_time": 0.01
        },
        "TTLCycleDesigner": "BetaTTLCycleDesigner",
        "TTLCycleDesignerParams": {},
        "sampleRate": 100000,
        "maxScanTimeMin": 1,
        "lineClockLine": null,
        "frameStartClockLine": null,
        "frameEndClockLine": null
    },
    "nidaq": {
        "timerCounterChannel": null,
        "startTrigger": false,
        "simulation": true
    },
    "availableWidgets": [
        "Settings",
        "View",
        "Recording",
        "Image",
        "Positioner",
        "Scan"
    ],
    "widgetLayout": {
        "right": [],
        "left": [
            ["Settings"],
            ["View"],
            ["Positioner"],
            ["Recording"],
            ["Scan"]
        ]
    }
}
