{
  "__comment__": "Hardware-free FLIM setup: the galvo APD mock scan setup plus a SIMULATED Swabian Time Tagger (timeTagger.simulation = true) and a SwabianTimeTaggerManager detector on it, so a lifetime scan can be designed, run, fitted and recorded with NO real hardware. The mock card images a synthetic sample (two bead populations with 1.5 ns and 4.0 ns lifetimes on a dim background; see timeTagger.mockSample) and takes its line and frame clocks from the scan designer's own TTL waveforms, so what the FLIM image shows is what the scan commanded. X/Y are galvo-like smooth axes, Z a piezo-like stepped axis; the APD still runs alongside. The Time Tagger calibration tutorials (scripts/tutorial/timetagger) and the FLIM histogram widget use it.",
  "detectors": {
    "APD": {
      "managerName": "APDManager",
      "managerProperties": {
        "ctrInputLine": "Dev1/ctr0",
        "terminal": "PFI0",
        "displayRotation": "0",
        "displayFlipX": "False",
        "displayFlipY": "False"
      },
      "analogChannel": null,
      "digitalLine": null,
      "forAcquisition": true,
      "forFocusLock": false
    },
    "FLIM": {
