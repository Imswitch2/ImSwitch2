{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "powerUnit": {
      "description": "Unit of the power field of a reading: ``\"W\"`` (default) or ``\"mW\"``.  Check against the Thorlabs software.",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "code:default:string",
        "code:optional(get)"
      ]
    },
    "serial": {
      "description": "Serial number, as in the VISA resource string.  Required.",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "code:required",
        "code:str()"
      ]
    },
    "timeoutMs": {
      "description": "VISA timeout in ms.  Default 5000.",
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-kind": "integer",
      "x-imswitch-source": [
        "code:default:integer",
        "code:int()",
        "code:optional(get)"
      ]
    },
    "updateBoundS": {
      "description": "A reading returned this long after a read started was measured entirely after it.  Default 0.5.",
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-kind": "number",
      "x-imswitch-source": [
        "code:default:number",
        "code:float()",
        "code:optional(get)"
      ]
    },
    "updatePeriodS": {
      "description": "Minimum spacing of distinct readings.  Default 0.1.",
      "type": [
        "integer",
        "number",
        "string"
      ],
      "x-imswitch-kind": "number",
      "x-imswitch-source": [
        "code:default:number",
        "code:float()",
        "code:optional(get)"
      ]
    },
    "visaBackend": {
      "description": "pyvisa backend: ``\"\"`` (NI-VISA, default) or ``\"@py\"`` (pyvisa-py).",
      "x-imswitch-kind": "string",
      "x-imswitch-source": [
        "code:default:string",
        "code:optional(get)"
      ]
    },
    "wavelengthNm": {
      "description": "Wavelength set on connect.  Optional.",
      "x-imswitch-kind": "number",
      "x-imswitch-nullable": true,
      "x-imswitch-source": [
        "code:optional(get)",
        "docs:number"
      ]
    }
  },
  "required": [
    "serial"
  ],
  "title": "ThorlabsPAX1000Manager managerProperties",
  "type": "object",
  "x-imswitch-classes": [
    "ThorlabsPAX1000Manager",
    "InstrumentManager"
  ]
}
